@using wetter.Web.Models
@model WeatherData
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Wetter Clock</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <style>
        :root { --bg-color: #ffffff; --text-color: #000000; }
        .theme-dark { --bg-color: #000000; --text-color: #ffffff; }
        body {
            background-color: #000;
            color: #fff;
            margin: 0;
            padding: 0;
            overflow: hidden;
            height: 100vh;
            width: 100vw;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif, 'Noto Color Emoji';
        }
        #sky-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2; /* LOWER THAN PARTICLES */
            transition: all 2s ease-in-out;
        }
        #particles-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1; /* HIGHER THAN SKY, LOWER THAN CONTENT */
            pointer-events: none;
        }
        .sky-day-clear { background: linear-gradient(to bottom, #0072ff 0%, #00c6ff 100%); }
        .sky-day-partly { background: linear-gradient(to bottom, #4facfe 0%, #a8edea 100%); }
        .sky-day-cloudy { background: linear-gradient(to bottom, #757f9a 0%, #d7dde8 100%); }
        .sky-twilight { background: linear-gradient(to bottom, #0c1435 0%, #2b1055 40%, #75225b 75%, #b55243 100%); }
        .sky-night-clear { background: linear-gradient(to bottom, #020111 10%, #3a7bd5 100%); }
        .sky-night-cloudy { background: linear-gradient(to bottom, #232526 0%, #414345 100%); }
        .sky-rain { background: linear-gradient(to bottom, #485563 0%, #29323c 100%); }
        .sky-storm { background: linear-gradient(to bottom, #0f2027 0%, #203a43 50%, #2c5364 100%); }

        /* GitLab Badge Styling */
        .gitlab-badge-container {
            display: flex;
            justify-content: center;
            margin-top: auto;
            padding-top: 12px;
            z-index: 1000;
            pointer-events: auto;
        }
        .gitlab-badge-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(10px) saturate(120%);
            -webkit-backdrop-filter: blur(10px) saturate(120%);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 30px;
            color: rgba(255, 255, 255, 0.75);
            font-size: 0.82rem;
            font-weight: 500;
            text-decoration: none;
            letter-spacing: 0.3px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.1);
            transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
        }
        .gitlab-badge-link:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(252, 109, 38, 0.4);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(252, 109, 38, 0.15), 0 0 12px rgba(252, 109, 38, 0.1);
        }
        .gitlab-badge-link:active {
            transform: translateY(0);
        }
        .gitlab-icon-wrapper {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            color: #fca326;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .gitlab-badge-link:hover .gitlab-icon-wrapper {
            transform: scale(1.15) rotate(15deg);
            color: #fc6d26;
        }
        .gitlab-text {
            transition: opacity 0.3s ease;
        }
    </style>
</head>
<body>
    <div id="sky-background" class="sky-day-clear"></div>
    <canvas id="particles-canvas"></canvas>
    <main role="main" class="h-100">
        @RenderBody()
    </main>
</body>
</html>
