@using System.Globalization
@model wetter.Web.Models.WeatherData
@{
    var culture = new CultureInfo(Model.Language);

    string GetWeatherIcon(int code, bool isDay) => code switch
    {
        0 => isDay ? "☀️" : "🌙", 
        1 => isDay ? "🌤️" : "☁️", 
        2 => isDay ? "⛅" : "☁️", 
        3 => "☁️", 
        45 or 48 => "☁️", 
        51 or 53 or 55 => "🌦️",
        56 or 57 => "🌨️", 
        61 or 63 or 65 => "🌧️", 
        66 or 67 => "🌨️", 
        71 or 73 or 75 or 77 => "❄️",
        80 or 81 or 82 => "🌧️", 
        85 or 86 => "🌨️", 
        95 or 96 or 99 => "⛈️", 
        _ => "❓"
    };
}

<div class="weather-station-container w-100 h-100 d-flex flex-column px-4">
    
    <!-- Top Row: Impactful Current Conditions -->
    <div class="d-flex justify-content-between align-items-center mb-3 mt-2" style="height: 35%;">
        <div class="d-flex align-items-center gap-4">
            <span id="current-weather-icon" style="font-size: clamp(5rem, 12vw, 10rem); filter: drop-shadow(0 0 15px rgba(0,0,0,0.5));">@GetWeatherIcon(Model.WeatherCode, Model.IsDaylight)</span>
            <div class="d-flex flex-column text-start">
                <h2 id="current-temperature" style="font-size: clamp(5rem, 12vw, 10rem); font-weight: 800; margin-bottom: -10px; white-space: nowrap; line-height: 1;">@Model.CurrentTemperature.ToString("F1")°C</h2>
                <div class="d-flex align-items-baseline gap-4">
                    <div id="city-name" class="heavy-shadow opacity-75 fs-2">@Model.CityName</div>
                    <div id="current-pressure" class="heavy-shadow opacity-50 fs-3">@((Model.Pressure ?? 0).ToString("F0")) <span class="fs-5">hPa</span></div>
                </div>
            </div>
        </div>
        
        <!-- Large Wind Compass -->
        <div class="d-flex flex-column align-items-center">
            <div class="position-relative" style="width: clamp(140px, 18vh, 180px); height: clamp(140px, 18vh, 180px);">
                <svg viewBox="0 0 100 100" class="w-100 h-100">
                    <circle cx="50" cy="50" r="48" fill="rgba(0,0,0,0.4)" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />
                    @for (int i = 0; i < 360; i += 30) { <line x1="50" y1="4" x2="50" y2="10" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" transform="rotate(@i 50 50)" /> }
                    <text x="50" y="16" text-anchor="middle" fill="white" font-size="10" font-weight="bold" class="opacity-75">N</text>
                    <text x="50" y="94" text-anchor="middle" fill="white" font-size="10" font-weight="bold" class="opacity-75">S</text>
                    <text x="14" y="54" text-anchor="middle" fill="white" font-size="10" font-weight="bold" class="opacity-75">W</text>
                    <text x="86" y="54" text-anchor="middle" fill="white" font-size="10" font-weight="bold" class="opacity-75">E</text>
                    <g id="wind-needle-svg" style="transition: transform 2s ease-in-out; transform-origin: center; transform: rotate(@(Model.WindDirection ?? 0)deg);">
                        <line x1="50" y1="50" x2="50" y2="15" stroke="#ffc107" stroke-width="4" stroke-linecap="round" />
                        <path d="M 50 8 L 58 24 L 42 24 Z" fill="#ffc107" />
                        <circle cx="50" cy="50" r="5" fill="#ffc107" />
                        <line x1="50" y1="50" x2="50" y2="70" stroke="rgba(255,193,7,0.6)" stroke-width="3" stroke-dasharray="3,3" />
                    </g>
                </svg>
                <div class="position-absolute top-50 start-50 translate-middle fs-4 fw-bold heavy-shadow mt-3" id="wind-dir-text">@(Model.WindDirection?.ToString("F0") ?? "0")°</div>
            </div>
            <div class="mt-2 fs-4 opacity-75 fw-bold">Windrichtung</div>
        </div>
    </div>

    <!-- Massive Sensor Grid -->
    <div class="flex-grow-1 d-grid gap-3 mb-3" style="grid-template-columns: repeat(3, 1fr); min-height: 0;">
        <!-- Wind Stats Card -->
        <div class="complication-frosted d-flex flex-column justify-content-center p-3 position-relative overflow-hidden">
            <div class="position-absolute start-0 bottom-0 w-100 h-40 opacity-50">
                <canvas id="chart-wind"></canvas>
            </div>
            <div class="fs-5 opacity-75 mb-1 z-index-1"><i class="bi bi-wind"></i> Windgeschwindigkeit</div>
            <div class="fw-bold z-index-1" id="current-wind" style="font-size: clamp(2rem, 5vh, 4rem); line-height: 1;">@((Model.WindSpeed ?? 0).ToString("F1")) <span class="fs-5 opacity-50">km/h</span></div>
            <div class="mt-3 pt-2 border-top border-secondary z-index-1">
                <div class="d-flex justify-content-between fs-5">
                    <span class="opacity-75">Böe</span>
                    <span class="fw-bold" id="current-gust">@((Model.WindGust ?? 0).ToString("F1"))</span>
                </div>
                <div class="d-flex justify-content-between fs-5">
                    <span class="opacity-75">Max Tag</span>
                    <span class="fw-bold" id="max-gust">@((Model.MaxDailyGust ?? 0).ToString("F1"))</span>
                </div>
            </div>
        </div>

        <!-- Environmental Card -->
        <div class="complication-frosted d-flex flex-column justify-content-center p-3 position-relative overflow-hidden">
            <div class="position-absolute start-0 bottom-0 w-100 h-40 opacity-50">
                <canvas id="chart-humi"></canvas>
            </div>
            <div class="fs-5 opacity-75 mb-1 z-index-1"><i class="bi bi-droplets"></i> Luftfeuchtigkeit</div>
            <div class="fw-bold z-index-1" id="current-humidity" style="font-size: clamp(3rem, 7vh, 5rem); line-height: 1;">@((Model.Humidity ?? 0).ToString("F0"))%</div>
            <div class="mt-3 pt-2 border-top border-secondary z-index-1">
                <div class="fs-5 opacity-75">Gefühlt</div>
                <div class="fs-3 fw-bold" id="feels-like-temp">@(Model.CurrentTemperature.ToString("F1"))°C</div>
            </div>
        </div>

        <!-- Solar Card -->
        <div class="complication-frosted d-flex flex-column justify-content-center p-3 position-relative overflow-hidden">
            <div class="position-absolute start-0 bottom-0 w-100 h-40 opacity-50">
                <canvas id="chart-solar"></canvas>
            </div>
            <div class="fs-5 opacity-75 mb-1 z-index-1"><i class="bi bi-sun"></i> Sonneneinstrahlung</div>
            <div class="fw-bold z-index-1" id="current-solar" style="font-size: clamp(2rem, 5vh, 4rem); line-height: 1;">@((Model.SolarRadiation ?? 0).ToString("F0")) <span class="fs-5 opacity-50">W/m²</span></div>
            <div class="mt-3 pt-2 border-top border-secondary z-index-1">
                <div class="fs-5 opacity-75">Tageslicht</div>
                <div class="fs-3 fw-bold text-warning" id="daylight-status">@(Model.IsDaylight ? "Aktiv" : "Nacht")</div>
            </div>
        </div>
    </div>
</div>

<style>
    .z-index-1 { z-index: 1; position: relative; }
    .h-40 { height: 40%; }
</style>
