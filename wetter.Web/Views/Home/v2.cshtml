@using System.Globalization
@model wetter.Web.Models.WeatherData
@{
    Layout = "_Layout";
}

<style>
    body { background-color: #000 !important; color: #fff; overflow: hidden; }
    #sky-background, #particles-canvas { display: none !important; }
    .v2-container { display: flex; width: 100vw; height: 100vh; overflow: hidden; position: relative; }
    .v2-left, .v2-right { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
    .v2-left { border-right: 2px solid #333; }
    
    .temp-block { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; border-bottom: 1px solid #222; }
    .temp-block:last-child { border-bottom: none; }
    .temp-value { font-size: clamp(3rem, 12vh, 10rem); font-weight: bold; line-height: 1; font-family: 'JetBrains Mono', monospace; }
    .temp-label { font-size: clamp(1rem, 3vh, 2rem); opacity: 0.6; text-transform: uppercase; letter-spacing: 2px; }

    .fc-card { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; border-right: 1px solid #222; }
    .fc-card:last-child { border-right: none; }
    .fc-time { font-size: clamp(0.8rem, 2vh, 1.5rem); opacity: 0.7; }
    .fc-icon { font-size: clamp(2rem, 5vh, 4rem); margin: 0.5vh 0; }
    .fc-temp { font-size: clamp(1.2rem, 3vh, 2rem); font-weight: bold; }

    @@media (orientation: portrait), (max-aspect-ratio: 1/1) {
        body { overflow-y: auto; overflow-x: hidden; }
        .v2-container { flex-direction: column; height: auto; min-height: 100vh; overflow-y: visible; overflow-x: hidden; }
        .v2-left { border-right: none; border-bottom: 2px solid #333; overflow: visible; }
        .v2-right { overflow: visible; display: flex; flex-direction: column; }
        .temp-block { padding: 4vh 0; }
        #v2-hourly-cards { padding: 2vh 0; min-height: 15vh; }
        #v2-daily-cards { padding: 2vh 0; min-height: 15vh; }
        #v2-timeline-container { height: 40vh; min-height: 300px; flex: none; }
        .temp-value { font-size: 8vh; }
        .temp-label { font-size: 2vh; }
    }
</style>

<div class="v2-container">
    <!-- Action Buttons -->
    <div style="position: absolute; top: 15px; left: 15px; z-index: 1000;">
        <button id="v2-reload-btn" class="btn btn-outline-secondary btn-lg opacity-25">
            <i class="bi bi-arrow-clockwise" style="font-size: 24px;"></i>
        </button>
    </div>
    <div style="position: absolute; top: 15px; right: 15px; z-index: 1000;">
        <button id="v2-fullscreen-btn" class="btn btn-outline-secondary btn-lg opacity-25">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-fullscreen" viewBox="0 0 16 16">
                <path d="M1.5 1a.5.5 0 0 0-.5.5v4a.5.5 0 0 1-1 0v-4A1.5 1.5 0 0 1 1.5 0h4a.5.5 0 0 1 0 1zM10 .5a.5.5 0 0 1 .5-.5h4A1.5 1.5 0 0 1 16 1.5v4a.5.5 0 0 1-1 0v-4a.5.5 0 0 0-.5-.5h-4a.5.5 0 0 1-.5-.5M.5 10a.5.5 0 0 1 .5.5v4a.5.5 0 0 0 .5.5h4a.5.5 0 0 1 0 1h-4A1.5 1.5 0 0 1 0 14.5v-4a.5.5 0 0 1 .5-.5m15 0.5a.5.5 0 0 0-.5-.5h-4a.5.5 0 0 0 0 1h4a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-1 0v-4a.5.5 0 0 0-.5-.5h-4a.5.5 0 0 1 0-1h4A1.5 1.5 0 0 1 16 10.5z"/>
            </svg>
        </button>
    </div>

    <div class="v2-left">
        <div class="temp-block">
            <div class="temp-value" id="v2-temp-out">@(Model.CurrentTemperature?.ToString("F1") ?? "N/A")°</div>
            <div class="temp-label">Outdoors</div>
        </div>
        <div class="temp-block">
            <div class="temp-value" id="v2-temp-up">@(Model.UpstairsTemperature?.ToString("F1") ?? "N/A")°</div>
            <div class="temp-label">Upstairs</div>
        </div>
        <div class="temp-block">
            <div class="temp-value" id="v2-temp-ground">@(Model.GroundFloorTemperature?.ToString("F1") ?? "N/A")°</div>
            <div class="temp-label">Ground Level</div>
        </div>
        <div class="temp-block">
            <div class="temp-value" id="v2-temp-base">@(Model.BasementTemperature?.ToString("F1") ?? "N/A")°</div>
            <div class="temp-label">Basement</div>
        </div>
    </div>
    <div class="v2-right" id="v2-right-col">
        <div style="flex: 0 0 25%; display: flex; border-bottom: 1px solid #222;" id="v2-hourly-cards">
            <!-- Populated via JS -->
        </div>
        <div style="flex: 0 0 25%; display: flex; border-bottom: 1px solid #222;" id="v2-daily-cards">
            <!-- Populated via JS -->
        </div>
        <div style="flex: 1; position: relative;" id="v2-timeline-container">
            <canvas id="v2-sun-curve" style="width: 100%; height: 100%; display: block;"></canvas>
        </div>
    </div>
    
    <!-- Version Label -->
    <div id="version-label" class="position-absolute bottom-0 end-0 p-2 opacity-25" style="font-size: 0.9rem; z-index: 1000; color: white; text-shadow: 0 2px 8px rgba(0,0,0,0.8);">@ViewData["Version"]</div>
</div>

<script>
(function() {
    function getWeatherIcon(code, isDay) {
        if (isDay === undefined) isDay = true;
        const icons = { 
            0: isDay ? "☀️" : "🌙", 1: isDay ? "🌤️" : "☁️", 2: isDay ? "⛅" : "☁️", 
            3: "☁️", 45: "☁️", 48: "☁️", 51: "🌦️", 53: "🌦️", 55: "🌦️", 61: "🌧️", 
            63: "🌧️", 65: "🌧️", 71: "❄️", 80: "🌧️", 81: "🌧️", 95: "⛈️" 
        };
        return icons[code] || "☁️";
    }

    function updateView() {
        fetch('/Home/Weather').then(r => r.json()).then(d => {
            document.getElementById('v2-temp-out').innerText = d.currentTemperature != null ? d.currentTemperature.toFixed(1) + '°' : 'N/A';
            document.getElementById('v2-temp-up').innerText = d.upstairsTemperature != null ? d.upstairsTemperature.toFixed(1) + '°' : 'N/A';
            document.getElementById('v2-temp-ground').innerText = d.groundFloorTemperature != null ? d.groundFloorTemperature.toFixed(1) + '°' : 'N/A';
            document.getElementById('v2-temp-base').innerText = d.basementTemperature != null ? d.basementTemperature.toFixed(1) + '°' : 'N/A';

            const hourly = d.hourly || [];
            let hHtml = '';
            hourly.slice(0, 6).forEach(h => {
                const t = new Date(h.time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                hHtml += `<div class="fc-card"><div class="fc-time">${t}</div><div class="fc-icon">${getWeatherIcon(h.weatherCode, true)}</div><div class="fc-temp">${Math.round(h.temp)}°</div></div>`;
            });
            document.getElementById('v2-hourly-cards').innerHTML = hHtml;

            const daily = d.forecast || [];
            let dHtml = '';
            daily.slice(0, 6).forEach(day => {
                const dt = new Date(day.date).toLocaleDateString('de-DE', { weekday: 'short' });
                dHtml += `<div class="fc-card"><div class="fc-time">${dt}</div><div class="fc-icon">${getWeatherIcon(day.weatherCode, true)}</div><div class="fc-temp">${Math.round(day.maxTemp)}°</div></div>`;
            });
            document.getElementById('v2-daily-cards').innerHTML = dHtml;
            
            // Stash data globally for canvas rendering
            window.v2Data = d;
        });
    }

    updateView();
    let updateInterval = setInterval(updateView, 30000); // 30s update
    
    // Reload logic
    function performSoftReload() {
        $.ajax({ url: '/Home/V2', cache: false, dataType: 'html', success: function(data) {
            clearInterval(updateInterval);
            const parser = new DOMParser(); 
            const newDoc = parser.parseFromString(data, 'text/html');
            $('body').html(newDoc.querySelector('body').innerHTML);
            // The newly injected script block will self-execute and restart everything
        }});
    }

    document.getElementById('v2-reload-btn').addEventListener('click', performSoftReload);
    document.getElementById('v2-fullscreen-btn').addEventListener('click', () => {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(err => console.warn(err));
        } else {
            document.exitFullscreen();
        }
    });

    function drawCanvas() {
        const canvas = document.getElementById('v2-sun-curve');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        
        // Auto-resize
        const rect = canvas.parentElement.getBoundingClientRect();
        if (canvas.width !== rect.width || canvas.height !== rect.height) {
            canvas.width = rect.width;
            canvas.height = rect.height;
        }
        
        const w = canvas.width, h = canvas.height;
        ctx.clearRect(0, 0, w, h);
        
        const hPad = 50;

        // Draw horizon
        const horizonY = h / 2;
        ctx.beginPath();
        ctx.strokeStyle = '#333';
        ctx.lineWidth = 1;
        ctx.moveTo(hPad, horizonY);
        ctx.lineTo(w - hPad, horizonY);
        ctx.stroke();

        const d = window.v2Data;
        if (!d) {
            requestAnimationFrame(drawCanvas);
            return;
        }

        const now = new Date();
        const msPer24h = 24 * 60 * 60 * 1000;
        const startT = now.getTime() - msPer24h;
        const endT = now.getTime() + msPer24h;
        const totalMs = endT - startT;

        function getX(t) {
            return hPad + ((t - startT) / totalMs) * (w - hPad * 2);
        }

        function drawLine(dataArray, valSelector, timeSelector, color, minY, maxY, topPct, bottomPct, showExtremes = false, suffix = '') {
            if (!dataArray || !dataArray.length) return;
            const pts = dataArray.map(item => ({
                t: new Date(timeSelector(item)).getTime(),
                v: valSelector(item)
            })).filter(p => p.t >= startT && p.t <= endT).sort((a,b) => a.t - b.t);

            if (pts.length < 2) return;
            
            ctx.beginPath();
            ctx.strokeStyle = color;
            ctx.lineWidth = 2;
            
            let pMin = pts[0], pMax = pts[0];
            const mappedPts = [];

            pts.forEach((p, i) => {
                const x = getX(p.t);
                
                if (p.v < pMin.v) pMin = p;
                if (p.v > pMax.v) pMax = p;
                
                // clamp value
                let val = p.v;
                if(val < minY) val = minY;
                if(val > maxY) val = maxY;
                
                const y = h * bottomPct - ((val - minY) / (maxY - minY)) * (h * (bottomPct - topPct));
                mappedPts.push({x, y, v: p.v});
                
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            });
            ctx.stroke();

            if (showExtremes) {
                ctx.fillStyle = color;
                ctx.font = 'bold 20px sans-serif';
                ctx.textAlign = 'center';
                
                // Draw Min
                const minMp = mappedPts.find(mp => mp.v === pMin.v);
                if (minMp) {
                    ctx.fillText(`${Math.round(pMin.v)}${suffix}`, minMp.x, minMp.y + 24);
                }
                
                // Draw Max
                const maxMp = mappedPts.find(mp => mp.v === pMax.v);
                if (maxMp && pMax.v !== pMin.v) { // Don't draw twice if min==max
                    ctx.fillText(`${Math.round(pMax.v)}${suffix}`, maxMp.x, maxMp.y - 12);
                }
            }
        }

        // Left Side (-24h)
        drawLine(d.tempHistory, p => p.value, p => p.time, '#ffc107', -10, 40, 0.05, 0.45, true, '°'); // Yellow
        drawLine(d.precipitationHistory, p => p.value, p => p.time, '#ffc107', 0, 20, 0.5, 0.7, true, 'mm'); // Yellow
        drawLine(d.windHistory, p => p.value, p => p.time, '#ffffff', 0, 100, 0.75, 0.95, true, 'km/h'); // White

        // Right Side (+24h)
        // Filter hourly to future
        const hourlyFcast = (d.hourly || []).filter(h => new Date(h.time).getTime() > now.getTime());
        drawLine(hourlyFcast, p => p.temp, p => p.time, '#fff3cd', -10, 40, 0.05, 0.45, true, '°'); // Light Yellow
        drawLine(hourlyFcast, p => p.precipitation, p => p.time, '#fff3cd', 0, 20, 0.5, 0.7, true, 'mm'); // Light Yellow
        drawLine(hourlyFcast, p => p.windSpeed, p => p.time, 'rgba(255, 255, 255, 0.7)', 0, 100, 0.75, 0.95, true, 'km/h'); // Light White

        // Draw Sun Curve
        const srDate = d.sunrise ? new Date(d.sunrise) : new Date(now.getFullYear(), now.getMonth(), now.getDate(), 6, 0, 0);
        const ssDate = d.sunset ? new Date(d.sunset) : new Date(now.getFullYear(), now.getMonth(), now.getDate(), 20, 0, 0);
        
        const srTimeOfDay = srDate.getHours() * 3600000 + srDate.getMinutes() * 60000 + srDate.getSeconds() * 1000;
        let ssTimeOfDay = ssDate.getHours() * 3600000 + ssDate.getMinutes() * 60000 + ssDate.getSeconds() * 1000;
        if (ssTimeOfDay <= srTimeOfDay) ssTimeOfDay += msPer24h; // Handle midnight wrap if any
        
        const dayLength = ssTimeOfDay - srTimeOfDay;
        const nightLength = msPer24h - dayLength;
        const curveAmp = h * 0.35;

        ctx.beginPath();
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
        ctx.setLineDash([4, 6]);
        ctx.lineWidth = 2;

        for (let x = hPad; x <= w - hPad; x += 2) {
            const t = startT + ((x - hPad) / (w - hPad * 2)) * totalMs;
            const dObj = new Date(t);
            let timeOfDay = dObj.getHours() * 3600000 + dObj.getMinutes() * 60000 + dObj.getSeconds() * 1000;
            if (timeOfDay < srTimeOfDay && ssTimeOfDay > msPer24h) timeOfDay += msPer24h; // match wrap

            let y = horizonY;
            if (timeOfDay >= srTimeOfDay && timeOfDay <= ssTimeOfDay) {
                const frac = (timeOfDay - srTimeOfDay) / dayLength;
                y = horizonY - Math.sin(frac * Math.PI) * curveAmp;
            } else {
                let frac;
                if (timeOfDay < srTimeOfDay) {
                    frac = (timeOfDay + (msPer24h - (ssTimeOfDay % msPer24h))) / nightLength;
                } else {
                    frac = (timeOfDay - ssTimeOfDay) / nightLength;
                }
                y = horizonY + Math.sin(frac * Math.PI) * curveAmp;
            }

            if (x === hPad) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
        }
        ctx.stroke();
        ctx.setLineDash([]);

        // Draw Sunrise / Sunset labels
        const events = [];
        for (let i = -1; i <= 1; i++) {
            const dayBase = new Date(now.getFullYear(), now.getMonth(), now.getDate() + i);
            if (d.sunrise) {
                const sr = new Date(d.sunrise);
                sr.setFullYear(dayBase.getFullYear(), dayBase.getMonth(), dayBase.getDate());
                events.push({ type: 'sunrise', t: sr.getTime() });
            }
            if (d.sunset) {
                const ss = new Date(d.sunset);
                ss.setFullYear(dayBase.getFullYear(), dayBase.getMonth(), dayBase.getDate());
                events.push({ type: 'sunset', t: ss.getTime() });
            }
        }

        ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
        ctx.font = '16px sans-serif';
        ctx.textAlign = 'center';
        
        events.forEach(ev => {
            if (ev.t >= startT && ev.t <= endT) {
                const x = getX(ev.t);
                const dObj = new Date(ev.t);
                const timeStr = dObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                
                ctx.beginPath();
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.5)';
                ctx.moveTo(x, horizonY - 15);
                ctx.lineTo(x, horizonY + 15);
                ctx.stroke();

                if (ev.type === 'sunrise') {
                    ctx.fillText(`🌅 ${timeStr}`, x, horizonY - 20);
                } else {
                    ctx.fillText(`🌇 ${timeStr}`, x, horizonY + 30);
                }
            }
        });

        // Draw Sun at Center
        const sunX = w / 2;
        
        let nowTimeOfDay = now.getHours() * 3600000 + now.getMinutes() * 60000 + now.getSeconds() * 1000;
        if (nowTimeOfDay < srTimeOfDay && ssTimeOfDay > msPer24h) nowTimeOfDay += msPer24h;
        let sunY = horizonY;
        if (nowTimeOfDay >= srTimeOfDay && nowTimeOfDay <= ssTimeOfDay) {
            const frac = (nowTimeOfDay - srTimeOfDay) / dayLength;
            sunY = horizonY - Math.sin(frac * Math.PI) * curveAmp;
        } else {
            let frac;
            if (nowTimeOfDay < srTimeOfDay) {
                frac = (nowTimeOfDay + (msPer24h - (ssTimeOfDay % msPer24h))) / nightLength;
            } else {
                frac = (nowTimeOfDay - ssTimeOfDay) / nightLength;
            }
            sunY = horizonY + Math.sin(frac * Math.PI) * curveAmp;
        }
        
        // Pulse effect
        const pulse = Math.sin(Date.now() / 500) * 5;
        
        ctx.beginPath();
        ctx.arc(sunX, sunY, 15 + pulse, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255, 193, 7, 0.3)';
        ctx.fill();

        ctx.beginPath();
        ctx.arc(sunX, sunY, 10, 0, Math.PI * 2);
        ctx.fillStyle = '#ffc107';
        ctx.fill();

        requestAnimationFrame(drawCanvas);
    }

    // Start animation loop
    drawCanvas();
})();
</script>
