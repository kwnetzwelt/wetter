    .transition-opacity { transition: opacity 0.3s ease; } .hover-opacity-100:hover { opacity: 1.0 !important; }
    #debug-status { position: fixed; bottom: 5px; left: 5px; font-size: 10px; opacity: 0.3; z-index: 1000; }
    .analog-clock { width: 200px; height: 200px; } .analog-clock svg { width: 100%; height: 100%; }
    .heavy-shadow { text-shadow: 0 2px 8px rgba(0,0,0,0.8); }
    .complication-frosted { background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 12px; display: inline-block; }
    #horizon-css-line { position: absolute; top: 50%; left: 5%; width: 90%; height: 1px; background: rgba(255, 255, 255, 0.3); z-index: 1; }
</style>
