@using System.Globalization
@model wetter.Web.Models.WeatherData
@{
    Layout = "_Layout";
    var culture = new CultureInfo(Model.Language);

    string GetTempHistoryJs() {
        if (Model.TempHistory == null || !Model.TempHistory.Any()) return "[]";
        var points = Model.TempHistory.Select(p => new { t = p.Time.ToString("yyyy-MM-ddTHH:mm:ssK"), v = p.Value });
        return System.Text.Json.JsonSerializer.Serialize(points);
    }

    string GetSolarHistoryJs() {
        if (Model.SolarHistory == null || !Model.SolarHistory.Any()) return "[]";
        var points = Model.SolarHistory.Select(p => new { t = p.Time.ToString("yyyy-MM-ddTHH:mm:ssK"), v = p.Value });
        return System.Text.Json.JsonSerializer.Serialize(points);
    }
}

<div class="dashboard-main-container d-flex w-100 h-100 overflow-hidden">
    <!-- Action Buttons -->
    <div style="position: absolute; top: 15px; left: 15px; z-index: 1000;">
        <button id="reload-btn" class="btn btn-outline-secondary btn-lg opacity-25">
            <i class="bi bi-arrow-clockwise" style="font-size: 24px;"></i>
        </button>
    </div>
    <div style="position: absolute; top: 15px; right: 15px; z-index: 1000;">
        <button id="fullscreen-btn" class="btn btn-outline-secondary btn-lg opacity-25">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-fullscreen" viewBox="0 0 16 16">
                <path d="M1.5 1a.5.5 0 0 0-.5.5v4a.5.5 0 0 1-1 0v-4A1.5 1.5 0 0 1 1.5 0h4a.5.5 0 0 1 0 1zM10 .5a.5.5 0 0 1 .5-.5h4A1.5 1.5 0 0 1 16 1.5v4a.5.5 0 0 1-1 0v-4a.5.5 0 0 0-.5-.5h-4a.5.5 0 0 1-.5-.5M.5 10a.5.5 0 0 1 .5.5v4a.5.5 0 0 0 .5.5h4a.5.5 0 0 1 0 1h-4A1.5 1.5 0 0 1 0 14.5v-4a.5.5 0 0 1 .5-.5m15 0.5a.5.5 0 0 0-.5-.5h-4a.5.5 0 0 0 0 1h4a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-1 0v-4a.5.5 0 0 0-.5-.5h-4a.5.5 0 0 1 0-1h4A1.5 1.5 0 0 1 16 10.5z"/>
            </svg>
        </button>
    </div>

    <!-- LEFT COLUMN -->
    <div id="left-column" class="d-flex flex-column border-end border-secondary">
        <div class="clock-complications-container d-flex flex-column align-items-center justify-content-center" style="height: 40vh; margin-bottom: 2vh;">
            <div class="analog-clock" style="height: 35vh; width: 35vh; max-width: 28vw; position: relative;">
                <div class="position-absolute w-100 h-100" style="top: 0; left: 0; pointer-events: none; z-index: 2;">
                    <div class="text-center" style="position: absolute; top: 62.5%; left: 50%; transform: translate(-50%, -50%); width: 85%;">
                        <div id="date-display" class="fw-bold text-white opacity-75" style="font-size: min(4.5rem, 9.5vh); line-height: 1; font-family: 'JetBrains Mono', monospace; filter: drop-shadow(0 0 10px rgba(0,0,0,0.5));">Laden...</div>
                    </div>
                </div>
                <svg viewBox="0 0 100 100" style="width: 100%; height: 100%; position: relative; z-index: 1;">
                    <circle cx="50" cy="50" r="48" stroke="currentColor" stroke-width="1.5" fill="rgba(0,0,0,0.1)" />
                    @for (int i = 0; i < 12; i++) { <line x1="50" y1="5" x2="50" y2="12" stroke="currentColor" stroke-width="2.5" transform="rotate(@(i * 30) 50 50)" /> }
                    <line id="hour-hand" x1="50" y1="50" x2="50" y2="28" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
                    <line id="minute-hand" x1="50" y1="50" x2="50" y2="18" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
                    <line id="second-hand" x1="50" y1="50" x2="50" y2="10" stroke="red" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="50" cy="50" r="2.5" fill="currentColor" />
                </svg>
            </div>
        </div>
        <div class="d-flex flex-column gap-4 flex-grow-1 justify-content-start" id="forecast-container" style="min-height: 0;">
            <div id="hourly-forecast-row" class="d-flex justify-content-between px-2 w-100 overflow-hidden" style="min-height: 0;"></div>
            <div id="daily-forecast-row" class="d-flex justify-content-between gap-2 px-1" style="min-height: 0;"></div>
        </div>

        <!-- GitLab Repository Badge -->
        <div class="gitlab-badge-container">
            <a href="https://gitlab.qwirl.eu/kai.wegner/wetter" target="_blank" rel="noopener noreferrer" class="gitlab-badge-link">
                <span class="gitlab-icon-wrapper">
                    <i class="bi bi-gitlab"></i>
                </span>
                <span class="gitlab-text">Source Code</span>
            </a>
        </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div id="right-column" class="d-flex flex-column flex-grow-1 p-0 overflow-hidden">
        <div id="weather-segment" class="d-flex flex-column justify-content-center overflow-hidden">
            @await Html.PartialAsync("_WeatherPartial", Model)
        </div>
        <div id="sun-tracker-segment" class="d-flex flex-column justify-content-center align-items-center overflow-hidden px-5" style="height: 25vh; background: rgba(0,0,0,0.15);">
            <div class="sun-tracker-container w-100">
                <div class="d-flex justify-content-between mb-2 px-3">
                    <div class="text-start heavy-shadow">
                        <i class="bi bi-sunrise fs-4 text-warning"></i>
                        <div id="sunrise-label" class="fs-5 fw-bold">@Model.Sunrise.ToLocalTime().ToString("HH:mm")</div>
                    </div>
                    <div class="text-end heavy-shadow">
                        <i class="bi bi-sunset fs-4 text-warning"></i>
                        <div id="sunset-label" class="fs-5 fw-bold">@Model.Sunset.ToLocalTime().ToString("HH:mm")</div>
                    </div>
                </div>
                <div class="position-relative" style="height: 14vh; width: 100%;">
                    <div id="horizon-css-line"></div>
                    <canvas id="sun-curve" style="width: 100%; height: 100%; position: relative; z-index: 2;"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div id="debug-status"></div>
    <div id="version-label" class="position-absolute bottom-0 end-0 p-2 heavy-shadow opacity-25" style="font-size: 0.9rem; z-index: 1000; color: white;">@ViewData["Version"]</div>

    <!-- Dev Tools -->
    <div id="dev-tools" class="position-absolute bottom-0 start-0 p-3 opacity-0 hover-opacity-100 transition-opacity" style="z-index: 2000;">
        <div class="card bg-dark border-secondary text-white small" style="width: 200px;">
            <div class="card-body p-2">
                <h6 class="card-title mb-2 fs-6">Dev Tools</h6>
                <div class="mb-2">
                    <label class="form-label mb-1">Weather</label>
                    <select id="dev-weather" class="form-select form-select-sm bg-dark text-white border-secondary">
                        <option value="0">Clear</option>
                        <option value="1">Partly Cloudy</option>
                        <option value="3">Overcast</option>
                        <option value="61">Rain</option>
                        <option value="71">Snow</option>
                        <option value="95">Storm</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label mb-1">Season</label>
                    <select id="dev-month" class="form-select form-select-sm bg-dark text-white border-secondary">
                        <option value="4">Spring</option>
                        <option value="7">Summer</option>
                        <option value="10">Autumn</option>
                        <option value="1">Winter</option>
                    </select>
                </div>
                <div class="mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="dev-is-day" checked>
                        <label class="form-check-label">Daylight</label>
                    </div>
                </div>
                <div class="mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="dev-is-twilight">
                        <label class="form-check-label">Twilight</label>
                    </div>
                </div>
                <button id="dev-reset" class="btn btn-outline-info btn-sm w-100 mt-1">Reset</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        // --- State Management ---
        window.currentAppVersion = '@ViewData["Version"]';
        window.serverTimeOffset = 0; 
        window.sunriseTime = new Date('@Model.Sunrise.ToString("yyyy-MM-ddTHH:mm:ssK")');
        window.sunsetTime = new Date('@Model.Sunset.ToString("yyyy-MM-ddTHH:mm:ssK")');
        window.lastWeatherCode = @Model.WeatherCode;
        window.tempHistory = @Html.Raw(GetTempHistoryJs());
        window.solarHistory = @Html.Raw(GetSolarHistoryJs());
        window.hourlyForecast = [];
        window.charts = {};
        window.sunPositionOverride = null;
        window.isDevOverride = false;
        window.sunAnimationId = null;

        async function requestWakeLock() { if ('wakeLock' in navigator) { try { window.wakeLock = await navigator.wakeLock.request('screen'); } catch (err) { } } }

        window.getNow = function() { return new Date(Date.now() + window.serverTimeOffset); };

        window.updateClock = function() {
            const now = window.getNow();
            $('#date-display').text(String(now.getDate()).padStart(2, '0'));
            const hDeg = (now.getHours() % 12) * 30 + now.getMinutes() * 0.5;
            const mDeg = now.getMinutes() * 6; const sDeg = now.getSeconds() * 6;
            $('#hour-hand').attr('transform', `rotate(${hDeg} 50 50)`); $('#minute-hand').attr('transform', `rotate(${mDeg} 50 50)`); $('#second-hand').attr('transform', `rotate(${sDeg} 50 50)`);
            
            if (!window.isDevOverride) {
                const isDay = now >= window.sunriseTime && now <= window.sunsetTime;
                const newSkyClass = getSkyClassJs(window.lastWeatherCode, isDay);
                if (newSkyClass !== $('#sky-background').attr('class')) {
                    $('#sky-background').attr('class', newSkyClass);
                    if (window.effectManager) window.effectManager.setEffects(window.lastWeatherCode, now.getMonth() + 1, isDay);
                }
            }
        };

        window.applyDevOverride = function() {
            const weatherCode = parseInt($('#dev-weather').val());
            const month = parseInt($('#dev-month').val());
            const isDay = $('#dev-is-day').is(':checked');
            const isTwilight = $('#dev-is-twilight').is(':checked');
            window.isDevOverride = true;
            if (isTwilight) {
                // Set sun position override close to horizon (0.24 or 0.76 depending on daylight check)
                window.sunPositionOverride = isDay ? 0.25 : 0.75;
            } else {
                window.sunPositionOverride = isDay ? 0.3 : 0.8;
            }
            $('#sky-background').attr('class', getSkyClassJs(weatherCode, isDay, isTwilight));
            if (window.effectManager) window.effectManager.setEffects(weatherCode, month, isDay);
        };

        function getSkyClassJs(code, isDay, isTwilightOverride) {
            code = parseInt(code); if (code >= 95) return "sky-storm"; if (code >= 51) return "sky-rain";
            
            // Check for twilight (dawn/dusk) under clear or partly cloudy conditions
            if (code == 0 || code == 1 || code == 2) {
                if (isTwilightOverride) {
                    return "sky-twilight";
                }
                const now = window.getNow();
                const diffSunrise = Math.abs(now - window.sunriseTime) / (60 * 1000);
                const diffSunset = Math.abs(now - window.sunsetTime) / (60 * 1000);
                if (diffSunrise <= 60 || diffSunset <= 60) {
                    return "sky-twilight";
                }
            }

            if (isDay) { if (code == 1 || code == 2) return "sky-day-partly"; if (code == 3 || (code >= 45 && code <= 48)) return "sky-day-cloudy"; return "sky-day-clear"; }
            else { if (code >= 1 && code <= 3) return "sky-night-cloudy"; return "sky-night-clear"; }
        }

        window.getWeatherIconJs = function(code, isDay) {
            if (isDay === undefined) isDay = true;
            const icons = { 
                0: isDay ? "☀️" : "🌙", 
                1: isDay ? "🌤️" : "☁️", 
                2: isDay ? "⛅" : "☁️", 
                3: "☁️", 
                45: "☁️", 
                48: "☁️", 
                51: "🌦️", 
                53: "🌦️", 
                55: "🌦️", 
                56: "🌨️", 
                57: "🌨️", 
                61: "🌧️", 
                63: "🌧️", 
                65: "🌧️", 
                66: "🌨️", 
                67: "🌨️", 
                71: "❄️", 
                73: "❄️", 
                75: "❄️", 
                77: "❄️", 
                80: "🌧️", 
                81: "🌧️", 
                82: "🌧️", 
                85: "🌨️", 
                86: "🌨️", 
                95: "⛈️", 
                96: "⛈️", 
                99: "⛈️" 
            };
            return icons[code] || "❓";
        };

        window.animateValue = function(obj, target, suffix) {
            const currentStr = obj.text().replace(suffix, "").replace(",", ".");
            let current = parseFloat(currentStr) || 0; if (Math.abs(current - target) < 0.05) return;
            const duration = 2000; const intervalMs = 50; const steps = duration / intervalMs;
            const step = Math.max(0.1, Math.abs(target - current) / steps);
            const interval = setInterval(() => {
                if (current < target) current = Math.min(target, current + step); else current = Math.max(target, current - step);
                obj.text(current.toFixed(1).replace(".", ",") + suffix);
                if (Math.abs(current - target) < 0.05) { clearInterval(interval); obj.text(target.toFixed(1).replace(".", ",") + suffix); }
            }, intervalMs); window.activeIntervals.push(interval);
        };

        // --- CHART.JS INTEGRATION (CARDS ONLY) ---
        function initSparkline(id, color) {
            const ctx = document.getElementById(id); if (!ctx) return null;
            return new Chart(ctx, {
                type: 'line',
                data: { labels: [], datasets: [{ data: [], borderColor: color, borderWidth: 2, fill: true, backgroundColor: color + '15', pointRadius: 0, tension: 0.45 }] },
                options: { 
                    responsive: true, maintainAspectRatio: false, 
                    plugins: { legend: { display: false }, tooltip: { enabled: false } },
                    scales: { x: { display: false }, y: { display: false } }
                }
            });
        }

        function updateChartData(chart, history) {
            if (!chart || !history || history.length < 2) return;
            const raw = history.map(p => ({ v: p.value ?? p.Value ?? p.v }));
            const maxPoints = 15; let sampled = [];
            if (raw.length > maxPoints) {
                const step = raw.length / maxPoints;
                for (let i = 0; i < maxPoints; i++) sampled.push(raw[Math.floor(i * step)]);
                sampled.push(raw[raw.length-1]);
            } else sampled = raw;
            chart.data.labels = sampled.map(() => "");
            chart.data.datasets[0].data = sampled.map(p => p.v);
            chart.update('none');
        }

        window.drawSunCurve = function() {
            const canvas = document.getElementById('sun-curve'); if (!canvas) return; const ctx = canvas.getContext('2d');
            if (canvas.width !== canvas.clientWidth || canvas.height !== canvas.clientHeight) { canvas.width = canvas.clientWidth; canvas.height = canvas.clientHeight; }
            const width = canvas.width, height = canvas.height;
            const vPadding = Math.max(12, Math.min(45, height * 0.16));
            const hPadding = Math.max(30, width * 0.08);
            const chartHeight = height - (vPadding * 2), chartWidth = width - (hPadding * 2);
            const now = window.getNow();
            const dayStart = new Date(now); dayStart.setHours(0,0,0,0);
            const totalMs = 24 * 60 * 60 * 1000, horizonY = height / 2;

            function getSunY(t) {
                const sRT = (window.sunriseTime - dayStart) / totalMs, sST = (window.sunsetTime - dayStart) / totalMs;
                if (t >= sRT && t <= sST) { const rT = (t - sRT) / (sST - sRT); return horizonY - Math.sin(Math.PI * rT) * (chartHeight / 2); }
                else { let rT; const nD = (1 - sST) + sRT; if (t < sRT) rT = (t + (1 - sST)) / nD; else rT = (t - sST) / nD; return horizonY + Math.sin(Math.PI * rT) * (chartHeight / 2); }
            }
            
            ctx.clearRect(0, 0, width, height);

            // Solar Radiation History Polyline with glowing fill
            if (window.solarHistory && window.solarHistory.length > 0) {
                let solarPoints = [];
                window.solarHistory.forEach(p => {
                    const t = new Date(p.t || p.time || p.Time);
                    if (t >= dayStart && t <= now) {
                        solarPoints.push({ t: t, v: p.v ?? p.value ?? p.Value });
                    }
                });
                solarPoints.sort((a, b) => a.t - b.t);

                if (solarPoints.length > 1) {
                    const sVals = solarPoints.map(p => p.v);
                    const sMax = Math.max(...sVals);
                    const sRange = Math.max(100, sMax);
                    
                    const screenPoints = solarPoints.map(p => {
                        const tNorm = (p.t - dayStart) / totalMs;
                        const yVal = (height - vPadding) - (p.v / sRange) * (chartHeight * 0.65);
                        return { x: hPadding + tNorm * chartWidth, y: yVal };
                    });

                    ctx.save();
                    
                    // Draw filled glowing area
                    ctx.beginPath();
                    ctx.moveTo(screenPoints[0].x, height - vPadding);
                    screenPoints.forEach(p => ctx.lineTo(p.x, p.y));
                    ctx.lineTo(screenPoints[screenPoints.length - 1].x, height - vPadding);
                    ctx.closePath();
                    
                    const fillGrad = ctx.createLinearGradient(0, height - vPadding - chartHeight, 0, height - vPadding);
                    fillGrad.addColorStop(0, 'rgba(255, 193, 7, 0.08)');
                    fillGrad.addColorStop(1, 'rgba(255, 193, 7, 0)');
                    ctx.fillStyle = fillGrad;
                    ctx.fill();

                    // Draw thin golden stroke
                    ctx.beginPath();
                    screenPoints.forEach((p, i) => {
                        if (i === 0) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y);
                    });
                    ctx.strokeStyle = 'rgba(255, 193, 7, 0.35)';
                    ctx.lineWidth = 1.5;
                    ctx.stroke();
                    
                    if (sMax > 20) {
                        const maxIdx = sVals.indexOf(sMax);
                        if (maxIdx !== -1) {
                            const peakP = screenPoints[maxIdx];
                            ctx.fillStyle = 'rgba(255, 193, 7, 0.55)';
                            ctx.font = '10px sans-serif';
                            ctx.textAlign = 'center';
                            ctx.fillText(`${Math.round(sMax)} W/m²`, peakP.x, peakP.y - 6);
                        }
                    }

                    ctx.restore();
                }
            }

            // Temperature Polyline with Min/Max
            let combined = [];
            if (window.tempHistory) window.tempHistory.forEach(p => { 
                const t = new Date(p.t || p.time || p.Time); 
                if (t >= dayStart && t <= now) combined.push({ t: t, v: p.v ?? p.value ?? p.Value }); 
            });
            if (window.hourlyForecast) window.hourlyForecast.forEach(h => { 
                const t = new Date(h.time || h.Time); 
                if (t > now && t < new Date(dayStart.getTime() + totalMs)) combined.push({ t: t, v: h.temp ?? h.Temp }); 
            });
            combined.sort((a,b) => a.t - b.t);

            if (combined.length > 1) {
                const vals = combined.map(p => p.v); const tMin = Math.min(...vals), tMax = Math.max(...vals), tRange = Math.max(2, tMax - tMin);
                const minIdx = vals.indexOf(tMin); const maxIdx = vals.indexOf(tMax);
                const points = combined.map(p => {
                    const tNorm = (p.t - dayStart) / totalMs;
                    return { x: hPadding + tNorm * chartWidth, y: (height - vPadding) - ((p.v - tMin) / tRange) * chartHeight };
                });

                ctx.save(); ctx.beginPath(); ctx.strokeStyle = '#fff'; ctx.lineWidth = 3;
                ctx.shadowBlur = 10; ctx.shadowColor = 'rgba(0,0,0,0.8)';
                points.forEach((p, i) => { if (i === 0) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y); });
                ctx.stroke();

                // Labels
                const fontSize = Math.max(10, Math.min(16, Math.round(height * 0.1)));
                ctx.fillStyle = '#fff'; ctx.font = `bold ${fontSize}px sans-serif`; ctx.textAlign = 'center'; ctx.shadowBlur = 5;
                const drawLabel = (idx, isMax) => {
                    const p = points[idx]; const val = combined[idx].v;
                    ctx.beginPath(); ctx.arc(p.x, p.y, 4, 0, Math.PI * 2); ctx.fill();
                    ctx.fillText(`${val.toFixed(1)}°`, p.x, p.y + (isMax ? -(fontSize * 0.6) : (fontSize * 1.1)));
                };
                if (minIdx !== -1) drawLabel(minIdx, false);
                if (maxIdx !== -1 && maxIdx !== minIdx) drawLabel(maxIdx, true);
                ctx.restore();
            }

            ctx.beginPath(); ctx.strokeStyle = 'rgba(255,255,255,0.2)'; ctx.lineWidth = 4; ctx.setLineDash([10, 10]);
            for (let x = 0; x <= chartWidth; x++) { const t = x / chartWidth; const y = getSunY(t); if (x === 0) ctx.moveTo(x + hPadding, y); else ctx.lineTo(x + hPadding, y); }
            ctx.stroke(); ctx.setLineDash([]);
            
            const sunT = window.sunPositionOverride !== null ? window.sunPositionOverride : (now - dayStart) / totalMs;
            const sunX = hPadding + sunT * chartWidth, sunY = getSunY(sunT);
            const baseRotation = (Date.now() / 1000); ctx.save(); ctx.translate(sunX, sunY); ctx.rotate(baseRotation); ctx.fillStyle = '#ffc107';
            for (let i = 0; i < 10; i++) {
                const sparkle = Math.sin(Date.now() / 450 + i * 0.8) * 3;
                ctx.beginPath(); ctx.moveTo(10, -3); ctx.lineTo(22 + sparkle, 0); ctx.lineTo(10, 3); ctx.fill(); ctx.rotate((Math.PI * 2) / 10);
            }
            ctx.restore(); ctx.beginPath(); ctx.arc(sunX, sunY, 9, 0, Math.PI * 2); ctx.fillStyle = '#ffc107'; ctx.shadowBlur = 15; ctx.shadowColor = '#ffc107'; ctx.fill(); ctx.shadowBlur = 0;
            window.sunAnimationId = requestAnimationFrame(window.drawSunCurve);
        };

        window.updateWeather = function() {
            $.get('/Home/Weather').done(function(data) {
                const d = data;
                if (d.version && d.version !== window.currentAppVersion) { location.reload(); return; }

                if (!window.isDevOverride) { window.lastWeatherCode = d.weatherCode ?? d.WeatherCode; }

                const newTempHistory = d.tempHistory || d.TempHistory;
                if (newTempHistory && newTempHistory.length > 0) window.tempHistory = newTempHistory;
                const newSolarHistory = d.solarHistory || d.SolarHistory;
                if (newSolarHistory && newSolarHistory.length > 0) window.solarHistory = newSolarHistory;
                window.hourlyForecast = d.hourly || d.Hourly || [];
                
                const sunrise = d.sunrise || d.Sunrise; const sunset = d.sunset || d.Sunset;
                if (sunrise) window.sunriseTime = new Date(sunrise); if (sunset) window.sunsetTime = new Date(sunset);
                
                const now = window.getNow();
                const isDay = now >= window.sunriseTime && now <= window.sunsetTime;
                
                const curTemp = parseFloat(d.currentTemperature ?? d.CurrentTemperature);
                if (!isNaN(curTemp)) {
                    window.animateValue($('#current-temperature'), curTemp, "°C");
                    window.animateValue($('#feels-like-temp'), curTemp, "°C");
                    window.animateValue($('#feels-like-temp-inside'), curTemp, "°C");
                } else {
                    $('#current-temperature').text("N/A");
                    $('#feels-like-temp').text("N/A");
                    $('#feels-like-temp-inside').text("N/A");
                }
                $('#current-weather-icon').text(window.getWeatherIconJs(window.lastWeatherCode, isDay));
                $('#city-name').text(d.cityName || d.CityName);
                
                // Detailed Weather Stats
                const pressure = parseFloat(d.pressure ?? d.Pressure);
                if (!isNaN(pressure)) {
                    window.animateValue($('#current-pressure'), pressure, " hPa");
                } else {
                    $('#current-pressure').text("N/A");
                }
                const windSpeed = parseFloat(d.windSpeed ?? d.WindSpeed);
                if (!isNaN(windSpeed)) {
                    window.animateValue($('#current-wind'), windSpeed, " km/h");
                    window.animateValue($('#current-wind-inside'), windSpeed, " km/h");
                } else {
                    $('#current-wind').text("N/A");
                    $('#current-wind-inside').text("N/A");
                }
                const windGust = parseFloat(d.windGust ?? d.WindGust);
                if (!isNaN(windGust)) {
                    window.animateValue($('#current-gust'), windGust, "");
                    window.animateValue($('#current-gust-inside'), windGust, "");
                } else {
                    $('#current-gust').text("N/A");
                    $('#current-gust-inside').text("N/A");
                }
                const maxGust = parseFloat(d.maxDailyGust ?? d.MaxDailyGust);
                if (!isNaN(maxGust)) {
                    window.animateValue($('#max-gust'), maxGust, "");
                    window.animateValue($('#max-gust-inside'), maxGust, "");
                } else {
                    $('#max-gust').text("N/A");
                    $('#max-gust-inside').text("N/A");
                }
                const humidity = parseFloat(d.humidity ?? d.Humidity);
                if (!isNaN(humidity)) {
                    window.animateValue($('#current-humidity'), humidity, "%");
                    window.animateValue($('#current-humidity-inside'), humidity, "%");
                } else {
                    $('#current-humidity').text("N/A");
                    $('#current-humidity-inside').text("N/A");
                }
                const solar = parseFloat(d.solarRadiation ?? d.SolarRadiation);
                if (!isNaN(solar)) {
                    window.animateValue($('#current-solar'), solar, " W/m²");
                    window.animateValue($('#current-solar-inside'), solar, " W/m²");
                } else {
                    $('#current-solar').text("N/A");
                    $('#current-solar-inside').text("N/A");
                }
                $('#daylight-status').text(isDay ? "Aktiv" : "Nacht");
                $('#daylight-status-inside').text(isDay ? "AKTIV" : "NACHT");

                // New 16:9 house blueprint dynamic updates
                const upTemp = parseFloat(d.upstairsTemperature ?? d.UpstairsTemperature);
                const groundTemp = parseFloat(d.groundFloorTemperature ?? d.GroundFloorTemperature);
                const baseTemp = parseFloat(d.basementTemperature ?? d.BasementTemperature);

                if (!isNaN(upTemp)) window.animateValue($('#house-upstairs-temp'), upTemp, "°C"); else $('#house-upstairs-temp').text("N/A");
                if (!isNaN(groundTemp)) window.animateValue($('#house-ground-temp'), groundTemp, "°C"); else $('#house-ground-temp').text("N/A");
                if (!isNaN(baseTemp)) window.animateValue($('#house-basement-temp'), baseTemp, "°C"); else $('#house-basement-temp').text("N/A");

                 const windDir = d.windDirection ?? d.WindDirection;
                 if (windDir !== null && windDir !== undefined) { 
                     $('#wind-needle-svg').css('transform', `rotate(${windDir}deg)`); 
                     $('#wind-dir-text').text(`${Math.round(windDir)}°`); 
                 } else {
                     $('#wind-dir-text').text("N/A");
                 }
                
                updateChartData(window.charts.wind, d.windHistory || d.WindHistory);
                updateChartData(window.charts.humi, d.humidityHistory || d.HumidityHistory);
                updateChartData(window.charts.solar, d.solarHistory || d.SolarHistory);

                if (window.hourlyForecast) {
                    let hHtml = ''; window.hourlyForecast.slice(0, 6).forEach(h => {
                        const hTime = new Date(h.time || h.Time);
                        const t = hTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                        const hIsDay = hTime >= window.sunriseTime && hTime <= window.sunsetTime;
                        hHtml += `<div class="text-center" style="flex: 1;"><div class="hourly-time" style="opacity: 0.8;">${t}</div><span class="hourly-icon d-block my-1">${window.getWeatherIconJs(h.weatherCode ?? h.WeatherCode, hIsDay)}</span><div class="hourly-temp fw-bold">${Math.round(h.temp ?? h.Temp)}°</div></div>`;
                    });
                    $('#hourly-forecast-row').html(hHtml);
                }
                  const daily = d.forecast || d.Forecast;
                  if (daily) {
                      let dHtml = ''; daily.slice(0, 5).forEach(day => {
                          const dt = new Date(day.date || day.Date).toLocaleDateString('@Model.Language', { weekday: 'short' });
                          const code = day.weatherCode ?? day.WeatherCode; const maxT = day.maxTemp ?? day.MaxTemp; const minT = day.minTemp ?? day.MinTemp;
                          dHtml += `<div class="forecast-day border d-flex flex-column justify-content-between p-2 text-center" style="flex: 1; min-width: 0; background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.2) !important; border-radius: 12px; height: 100%; min-height: 0; overflow: hidden;"><div class="daily-time fw-bold">${dt}</div><span class="d-block my-1 daily-icon">${window.getWeatherIconJs(code, true)}</span><div><div class="fw-bold daily-temp-max">${Math.round(maxT)}°</div><div class="opacity-75 daily-temp-min">${Math.round(minT)}°</div></div></div>`;
                      });
                      $('#daily-forecast-row').html(dHtml);
                  }
                
                $('#sunrise-label').text(window.sunriseTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }));
                $('#sunset-label').text(window.sunsetTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }));
            });
        };

        window.checkServerStatus = function() {
            const start = Date.now(); $.ajax({ url: '/api/health', timeout: 5000, cache: false }).done(function(data) {
                const end = Date.now(); if (data.serverTime) window.serverTimeOffset = (new Date(data.serverTime).getTime() + (end - start)/2) - end;
                if (data.version && data.version !== window.currentAppVersion) { window.performSoftReload(); }
            });
        };

        window.performSoftReload = function() {
            $.ajax({ url: '/', cache: false, dataType: 'html', success: function(data) {
                if (window.activeIntervals) window.activeIntervals.forEach(clearInterval); window.activeIntervals = [];
                if (window.sunAnimationId) cancelAnimationFrame(window.sunAnimationId);
                const parser = new DOMParser(); const newDoc = parser.parseFromString(data, 'text/html');
                $('body').html(newDoc.querySelector('body').innerHTML);
            }});
        };

        $(document).ready(function() {
            window.activeIntervals = window.activeIntervals || [];
            window.updateClock(); window.activeIntervals.push(setInterval(window.updateClock, 1000));
            window.drawSunCurve();
            window.charts.wind = initSparkline('chart-wind', '#ffffff');
            window.charts.humi = initSparkline('chart-humi', '#ffffff');
            window.charts.solar = initSparkline('chart-solar', '#ffc107');

            requestWakeLock(); window.activeIntervals.push(setInterval(requestWakeLock, 30000));
            window.updateWeather(); window.activeIntervals.push(setInterval(window.updateWeather, 5000));
            window.checkServerStatus(); window.activeIntervals.push(setInterval(window.checkServerStatus, 10000));
            
            // Persistent Click Listeners
            $(document).on('click', '#fullscreen-btn', () => document.documentElement.requestFullscreen());
            $(document).on('click', '#reload-btn', () => window.performSoftReload());
            $(document).on('change', '#dev-weather, #dev-month, #dev-is-day, #dev-is-twilight', window.applyDevOverride);
            $(document).on('click', '#dev-reset', () => window.performSoftReload());
            
            if (window.effectManager) window.effectManager.setEffects(window.lastWeatherCode, new Date().getMonth() + 1, @(Model.IsDaylight ? "true" : "false"));
        });
    })();
</script>

